{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoledger.local/schemas/test.schema.json",
  "title": "Dynamic test result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "iteration", "agent", "role", "base_sha", "target_sha", "status", "created_at", "finished_at", "sandbox", "redactions_applied", "tests"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "iteration": { "type": "integer", "minimum": 1, "maximum": 3 },
    "agent": { "type": "string", "minLength": 1 },
    "role": { "const": "dynamic-test" },
    "base_sha": { "$ref": "#/$defs/sha" },
    "target_sha": { "$ref": "#/$defs/sha" },
    "status": { "enum": ["passed", "failed", "blocked", "not_run"] },
    "created_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "sandbox": { "enum": ["docker", "vm", "unavailable"] },
    "redactions_applied": { "type": "boolean" },
    "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "status", "exit_code"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "exit_code": { "type": ["integer", "null"] },
        "log_path": { "type": ["string", "null"] }
      }
    }
  }
}
