{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoledger.local/schemas/run.schema.json",
  "title": "Collaboration run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "objective", "acceptance_criteria", "base_sha", "branch", "worktree_path", "max_iterations", "status"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "created_at": { "type": "string", "format": "date-time" },
    "objective": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "base_sha": { "$ref": "#/$defs/sha" },
    "target_sha": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
    "branch": { "type": "string", "pattern": "^collab/[a-z0-9][a-z0-9-]{0,63}$" },
    "worktree_path": { "type": "string", "pattern": "^\\.worktrees/[a-z0-9][a-z0-9-]{0,63}$" },
    "max_iterations": { "type": "integer", "minimum": 1, "maximum": 3 },
    "status": { "enum": ["in_progress", "blocked", "completed", "abandoned"] }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" }
  }
}
