      "text": "안전한 계정 삭제 및 데이터 파기",
      "fontSize": 13.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "안전한 계정 삭제 및 데이터 파기",
      "autoResize": true,
      "lineHeight": 1.4
    },
    {
