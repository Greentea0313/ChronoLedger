      "locked": false,
      "text": "날짜별 상세 패널 (데스크톱 사이드바 / 모바일 하단 서랍)",
      "fontSize": 13.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "날짜별 상세 패널 (데스크톱 사이드바 / 모바일 하단 서랍)",
      "autoResize": true,
