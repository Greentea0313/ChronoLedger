    },
    {
      "id": "fc424123ab8340f6a0e9",
      "type": "text",
      "x": 76,
      "y": 1018,
      "width": 616,
      "height": 36,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
