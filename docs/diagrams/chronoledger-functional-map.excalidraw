      "text": "오늘·이번 주 요약 & 만료 지출 알림",
      "fontSize": 13.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "오늘·이번 주 요약 & 만료 지출 알림",
      "autoResize": true,
      "lineHeight": 1.4
    },
    {
      "id": "85d8f2d8c55f42b18778",
      "type": "text",
      "x": 1044,
      "y": 556,
      "width": 616,
      "height": 36,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
