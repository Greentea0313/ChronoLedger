    },
    {
      "id": "1e9e358665cf4ced8447",
      "type": "text",
      "x": 1044,
      "y": 458,
      "width": 616,
      "height": 36,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
