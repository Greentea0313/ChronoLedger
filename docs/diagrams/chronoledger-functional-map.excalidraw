      "text": "내 게임 구독 관리 & 게임별 상세 타임라인",
      "fontSize": 13.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "내 게임 구독 관리 & 게임별 상세 타임라인",
      "autoResize": true,
      "lineHeight": 1.4
    },
    {
      "id": "30c9b13e93e34d999390",
      "type": "text",
      "x": 2012,
      "y": 360,
      "width": 616,
      "height": 36,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
