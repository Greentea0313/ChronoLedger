      "text": "게스트 체험 모드 (비로그인 열람)",
      "fontSize": 13.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "게스트 체험 모드 (비로그인 열람)",
      "autoResize": true,
      "lineHeight": 1.4
    },
    {
      "id": "b0e655dffdfe4179baee",
      "type": "text",
      "x": 76,
      "y": 360,
      "width": 616,
      "height": 36,
      "angle": 0,
      "strokeColor": "#343a40",
