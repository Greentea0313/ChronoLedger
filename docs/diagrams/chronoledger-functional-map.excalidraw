      "text": "월간 캘린더 ↔ 주차별 리스트 전환",
      "fontSize": 13.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "월간 캘린더 ↔ 주차별 리스트 전환",
      "autoResize": true,
