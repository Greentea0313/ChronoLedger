# Cloudflare Pages / Static Hosting Caching & Security Headers

# Immutable assets (Next.js hashed chunks)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Service Worker must always revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# PWA Web Manifest & Favicon
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
/favicon.ico
  Cache-Control: public, max-age=86400

# Global Security Headers
# The full CSP is a per-page <meta> injected by scripts/inject-csp.mjs; frame-ancestors only works as a header.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'

